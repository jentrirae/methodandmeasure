---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import servicesImage from "../images/mm-services.jpg";
import deskImage from "../images/mm-templates.jpg";

const services = [
	{
		index: "01 /",
		title: "Ongoing Operations Support",
		lead: "Steady operational ownership, without adding another full-time hire.",
		detail:
			"Coordination, recurring operational work, system maintenance, follow-through, documentation, and keeping priorities moving week to week.",
	},
	{
		index: "02 /",
		title: "Bookkeeping & Financial Tracking",
		lead: "Clear, current books you can actually use to make decisions.",
		detail:
			"Bookkeeping, reconciliations, and financial tracking from a QuickBooks Certified ProAdvisor — accurate and ready when you need them.",
	},
	{
		index: "03 /",
		title: "Scoped Projects",
		lead: "For one-time work that needs an owner from start to finish.",
		detail:
			"Audits, systems setup, SOPs, and other defined projects — scoped up front and quoted after scoping, built to fit how the business actually runs.",
	},
];

const framework = [
	{
		index: "01",
		title: "Measure",
		copy: "Understand what is happening now. Find the bottlenecks, gaps, and places where too much depends on memory or manual follow-up.",
	},
	{
		index: "02",
		title: "Method",
		copy: "Build the practical solution: workflows, systems, processes, documentation, tools, and structure designed around how the business actually operates.",
	},
	{
		index: "03",
		title: "Maintain",
		copy: "Implement it, document it, support adoption, and create enough structure for the improvement to keep working after the initial project.",
	},
];
---

<Layout title="Method &amp; Measure — Systems That Simplify. Strategy That Scales.">
	<main>
		<!-- SECTION 1: HERO -->
		<section id="top" class="mx-auto max-w-7xl px-6 pt-12 pb-10 lg:px-8 lg:pt-14 lg:pb-12 scroll-mt-8">
			<div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-center lg:gap-12">
				<div class="lg:col-span-7">
					<p class="font-sans text-xs tracking-editorial uppercase text-brand-muted">
						Operations &amp; Bookkeeping for Small Businesses
					</p>
					<h1 class="mt-3 font-serif text-4xl sm:text-5xl lg:text-6xl text-brand-black leading-tight">
						The work behind a well-run business, handled.
					</h1>

					<p class="mt-6 max-w-lg font-sans text-base leading-relaxed text-brand-muted">
						Method &amp; Measure provides ongoing operations support, bookkeeping and financial
						tracking, and scoped projects — audits, systems setup, SOPs — for small businesses that
						need things running smoothly without hiring another full-time person.
					</p>

					<div class="mt-8 flex flex-wrap items-center gap-6">
						<a
							href="#contact"
							class="bg-brand-black text-brand-cream text-xs uppercase tracking-editorial px-6 py-3 transition-colors hover:bg-gray-800"
						>
							Work With Method &amp; Measure
						</a>
						<a
							href="#services"
							class="font-sans text-xs uppercase tracking-editorial text-brand-muted transition-colors hover:text-brand-black"
						>
							See What We Do ↓
						</a>
					</div>
				</div>

				<div class="lg:col-span-5">
					<div class="aspect-[4/5] overflow-hidden border border-brand-border bg-brand-card/40">
						<!-- Photography: hands annotating a process checklist beside an open notebook and laptop. No visible face. -->
						<Image
							src={servicesImage}
							alt="Hands reviewing and annotating an operational process checklist"
							width={900}
							class="h-full w-full object-cover object-[60%_center]"
							loading="eager"
						/>
					</div>
				</div>
			</div>
		</section>

		<!-- SECTION 2: SERVICES -->
		<section id="services" class="bg-brand-cream py-12 lg:py-14 border-b border-brand-border scroll-mt-8">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<p class="text-brand-muted font-sans text-xs tracking-editorial uppercase">SERVICES</p>
				<h2 class="mt-3 max-w-2xl font-serif text-4xl md:text-5xl text-brand-black leading-tight">
					Ongoing support and bookkeeping — plus projects when you need them.
				</h2>
				<p class="mt-4 max-w-2xl font-sans text-sm leading-relaxed text-brand-muted">
					Most clients start with steady operational support or bookkeeping. Scoped projects pick
					up the one-time work — audits, systems setup, SOPs — that needs a clear start and finish.
				</p>

				<div class="mt-10 grid grid-cols-1 gap-10 border-t border-brand-border pt-10 md:grid-cols-3 md:gap-8">
					{
						services.map((service) => (
							<div class="flex flex-col gap-3">
								<span class="font-serif text-sm italic text-brand-muted">{service.index}</span>
								<h3 class="font-sans text-sm tracking-editorial uppercase text-brand-black font-medium">
									{service.title}
								</h3>
								<p class="font-sans text-sm leading-relaxed text-brand-black">{service.lead}</p>
								<p class="font-sans text-sm leading-relaxed text-brand-muted">{service.detail}</p>
							</div>
						))
					}
				</div>

				<div class="mt-10 flex items-center justify-between gap-6 border-t border-brand-border pt-8">
					<p class="font-sans text-sm leading-relaxed text-brand-muted">
						Retainers and project rates, laid out plainly.
					</p>
					<a
						href="/pricing"
						class="shrink-0 font-sans text-xs uppercase tracking-editorial text-brand-black border-b border-brand-black pb-0.5 transition-colors hover:text-brand-muted hover:border-brand-muted"
					>
						View Pricing →
					</a>
				</div>
			</div>
		</section>

		<!-- SECTION 3: HOW WE WORK -->
		<section id="how-we-work" class="bg-brand-olive text-brand-cream py-14 scroll-mt-8">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<p class="font-sans text-xs tracking-editorial uppercase text-brand-cream/70">HOW WE WORK</p>
				<h2 class="mt-3 max-w-2xl font-serif text-4xl md:text-5xl">
					Understand the work. Build the right systems. Keep the business moving.
				</h2>

				<div class="mt-10 grid grid-cols-1 divide-y divide-white/15 md:grid-cols-3 md:divide-y-0 md:divide-x">
					{
						framework.map((step) => (
							<div class="flex flex-col gap-4 px-0 py-8 md:px-10 md:py-0 first:pt-0 md:first:pl-0">
								<span class="font-serif text-sm italic text-brand-muted">{step.index} /</span>
								<h3 class="font-sans text-sm tracking-editorial uppercase text-brand-cream font-medium">
									{step.title}
								</h3>
								<p class="font-sans text-sm leading-relaxed text-brand-cream/80">{step.copy}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- SECTION 4: ABOUT METHOD & MEASURE -->
		<section id="about" class="bg-brand-cream py-12 border-b border-brand-border scroll-mt-8">
			<div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-6 lg:grid-cols-5 lg:gap-16 lg:px-8">
				<div class="lg:col-span-2">
					<div class="aspect-[4/5] overflow-hidden border border-brand-border">
						<!-- Photography: desk with planning worksheets, inventory sheets, and a calculator. No visible face. -->
						<Image
							src={deskImage}
							alt="Desk with planning worksheets, calculator, and notes representing hands-on operational and bookkeeping work"
							width={700}
							class="h-full w-full object-cover"
							loading="lazy"
						/>
					</div>
				</div>

				<div class="flex flex-col justify-center lg:col-span-3">
					<p class="text-brand-muted font-sans text-xs tracking-editorial uppercase">ABOUT METHOD &amp; MEASURE</p>
					<h2 class="mt-3 font-serif text-4xl md:text-5xl text-brand-black leading-tight">
						Built from inside operations.
					</h2>
					<p class="mt-6 font-sans text-sm leading-relaxed text-brand-muted">
						Method &amp; Measure grew out of years spent running operations for growing small
						businesses — building systems, managing teams, keeping the books straight, solving
						operational problems, and bringing structure to businesses as they grew.
					</p>
					<p class="mt-4 font-sans text-sm leading-relaxed text-brand-muted">
						Jentri is a QuickBooks Certified ProAdvisor. The work is grounded in what is operationally
						realistic, not theoretical. The goal is not to hand over a recommendation and disappear —
						it is to build something useful, implementable, and sustainable.
					</p>
					<p class="mt-4 font-sans text-sm leading-relaxed text-brand-muted">
						Most engagements start with a conversation about what isn't working, then settle into
						whichever mix of ongoing support, bookkeeping, or project work fits the business —
						adjusting as priorities change.
					</p>
				</div>
			</div>
		</section>

		<!-- SECTION 5: CONTACT -->
		<section id="contact" class="bg-brand-cream pt-12 pb-14 scroll-mt-8">
			<div class="mx-auto max-w-3xl px-6 lg:px-8">
				<p class="text-brand-muted font-sans text-xs tracking-editorial uppercase">CONTACT</p>
				<h2 class="mt-3 font-serif text-4xl md:text-5xl text-brand-black leading-tight">Let's find the right fit.</h2>
				<p class="mt-6 max-w-xl font-sans text-sm leading-relaxed text-brand-muted">
					Tell me a bit about the business and what you need — ongoing support, bookkeeping, or a
					specific project. I'll follow up from there.
				</p>

				<form id="contact-form" class="mt-10 flex flex-col gap-6">
					<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
						<div class="flex flex-col gap-2">
							<label class="font-sans text-xs tracking-editorial uppercase text-brand-black" for="name">Name</label>
							<input
								id="name"
								name="name"
								type="text"
								required
								class="w-full border border-brand-border bg-brand-card px-4 py-3 font-sans text-sm text-brand-black placeholder:text-brand-muted focus:border-brand-black focus:outline-none"
								placeholder="Jane Doe"
							/>
						</div>
						<div class="flex flex-col gap-2">
							<label class="font-sans text-xs tracking-editorial uppercase text-brand-black" for="email">Email</label>
							<input
								id="email"
								name="email"
								type="email"
								required
								class="w-full border border-brand-border bg-brand-card px-4 py-3 font-sans text-sm text-brand-black placeholder:text-brand-muted focus:border-brand-black focus:outline-none"
								placeholder="jane@example.com"
							/>
						</div>
					</div>

					<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
						<div class="flex flex-col gap-2">
							<label class="font-sans text-xs tracking-editorial uppercase text-brand-black" for="business">
								Business Name
							</label>
							<input
								id="business"
								name="business"
								type="text"
								required
								class="w-full border border-brand-border bg-brand-card px-4 py-3 font-sans text-sm text-brand-black placeholder:text-brand-muted focus:border-brand-black focus:outline-none"
								placeholder="e.g. Acme Co."
							/>
						</div>
						<div class="flex flex-col gap-2">
							<label class="font-sans text-xs tracking-editorial uppercase text-brand-black" for="phone">
								Phone <span class="text-brand-muted">(optional)</span>
							</label>
							<input
								id="phone"
								name="phone"
								type="tel"
								class="w-full border border-brand-border bg-brand-card px-4 py-3 font-sans text-sm text-brand-black placeholder:text-brand-muted focus:border-brand-black focus:outline-none"
								placeholder="e.g. 555-123-4567"
							/>
						</div>
					</div>

					<div class="flex flex-col gap-2">
						<label class="font-sans text-xs tracking-editorial uppercase text-brand-black" for="message">
							What's going on?
						</label>
						<textarea
							id="message"
							name="message"
							required
							rows="5"
							class="w-full border border-brand-border bg-brand-card px-4 py-3 font-sans text-sm text-brand-black placeholder:text-brand-muted focus:border-brand-black focus:outline-none"
							placeholder="What's not working, what needs to change, or what have you been meaning to get off your plate?"
						></textarea>
					</div>

					<div class="mt-2">
						<button
							type="submit"
							class="bg-brand-black text-brand-cream text-xs uppercase tracking-editorial px-6 py-3 transition-colors hover:bg-gray-800"
						>
							Submit Inquiry
						</button>
					</div>

					<p id="contact-success" class="hidden border border-brand-border bg-brand-card px-6 py-5 font-sans text-sm text-brand-black">
						Thanks — your inquiry has been received. We'll follow up by email within one to two business days.
					</p>
				</form>
			</div>
		</section>
	</main>

	<script>
		const form = document.getElementById("contact-form") as HTMLFormElement;
		const success = document.getElementById("contact-success") as HTMLParagraphElement;

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!form.checkValidity()) {
				form.reportValidity();
				return;
			}
			form.reset();
			success.classList.remove("hidden");
		});
	</script>
</Layout>
