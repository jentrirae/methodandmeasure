---
import Layout from "../layouts/Layout.astro";

const methodology = [
	{
		index: "01",
		title: "Measure",
		copy: "Before anything changes, I map how work actually moves today — not how the org chart says it should. Bottlenecks, hand-offs, and workarounds all get surfaced first.",
	},
	{
		index: "02",
		title: "Method",
		copy: "From there, I design the system: the workflow, the tooling, the documentation. Built for how your team actually operates, not a generic template.",
	},
	{
		index: "03",
		title: "Maintain",
		copy: "A system nobody owns falls apart in a month. I hand off with training and documentation so it keeps running long after the engagement ends.",
	},
];

const positioning = [
	{
		title: "Not a generalist consultant",
		copy: "I've run the back-of-house, not just advised on it. Recommendations are grounded in what's operationally realistic, not theoretical.",
	},
	{
		title: "Not a task-only assistant",
		copy: "I'm brought in to fix the system, not just clear the inbox. Support scales up into strategy wherever the business needs it.",
	},
	{
		title: "Built for small, growing teams",
		copy: "Every engagement is scoped for businesses that need real infrastructure but aren't ready for a full ops hire yet.",
	},
];
---

<Layout title="About — Method &amp; Measure" description="Operational background, methodology, and practical positioning behind Method &amp; Measure.">
	<main class="bg-brand-cream">
		<!-- INTRO -->
		<section class="mx-auto max-w-7xl px-6 py-16 lg:px-8 lg:py-24">
			<div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-20">
				<div class="border border-brand-border bg-brand-card">
					<div class="flex aspect-[4/5] w-full items-center justify-center bg-gradient-to-br from-brand-border/50 to-brand-card">
						<span class="font-serif text-sm italic text-brand-muted">Portrait photo</span>
					</div>
				</div>

				<div>
					<p class="text-brand-muted font-sans text-xs tracking-editorial uppercase">ABOUT</p>
					<h1 class="mt-3 font-serif text-5xl md:text-6xl text-brand-black leading-tight">
						Operations background. Strategic mindset.
					</h1>
					<p class="mt-6 font-sans text-sm leading-relaxed text-brand-muted">
						I spent years running the back-of-house for growing hospitality brands — the scheduling, the
						vendor relationships, the process that has to hold up on a Friday night whether or not
						anyone's watching. That's where I learned that most businesses aren't short on effort.
						They're short on systems.
					</p>
					<p class="mt-4 font-sans text-sm leading-relaxed text-brand-muted">
						Method &amp; Measure grew out of that experience: hands-on operational rigor paired with a
						strategist's eye for what actually moves a business forward. Not more process for its own
						sake — the specific system that removes the specific bottleneck that's costing you time.
					</p>
				</div>
			</div>
		</section>

		<!-- METHODOLOGY -->
		<section class="bg-brand-olive text-brand-cream py-16 border-y border-brand-olive">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<p class="font-sans text-xs tracking-editorial uppercase text-brand-cream/70">METHODOLOGY</p>
				<h2 class="mt-3 font-serif text-3xl md:text-4xl">How the work actually happens.</h2>

				<div class="mt-12 grid grid-cols-1 divide-y divide-white/15 md:grid-cols-3 md:divide-y-0 md:divide-x">
					{
						methodology.map((step) => (
							<div class="flex flex-col gap-4 px-0 py-8 md:px-10 md:py-0 first:pt-0 md:first:pl-0">
								<span class="font-serif text-sm italic text-brand-muted">{step.index} /</span>
								<h3 class="font-sans text-sm tracking-editorial uppercase text-brand-cream font-medium">
									{step.title}
								</h3>
								<p class="font-sans text-sm leading-relaxed text-brand-cream/80">{step.copy}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- PRACTICAL POSITIONING -->
		<section class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
			<div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-20">
				<div>
					<p class="text-brand-muted font-sans text-xs tracking-editorial uppercase">WHERE I FIT</p>
					<h2 class="mt-3 font-serif text-4xl md:text-5xl text-brand-black leading-tight">
						Practical positioning, not a job title.
					</h2>
					<p class="mt-6 font-sans text-sm leading-relaxed text-brand-muted">
						Most small businesses don't need a big-four consultant or a full-time hire — they need
						someone who can step in, understand the operation, and leave behind something that
						actually works.
					</p>
					<a
						href="/contact"
						class="mt-6 inline-block font-sans text-xs uppercase tracking-editorial border-b border-brand-black pb-0.5 text-brand-black"
					>
						WORK WITH ME →
					</a>
				</div>

				<div class="flex flex-col divide-y divide-brand-border border-t border-b border-brand-border">
					{
						positioning.map((point) => (
							<div class="flex flex-col gap-2 py-6">
								<h3 class="font-serif text-lg text-brand-black">{point.title}</h3>
								<p class="font-sans text-sm leading-relaxed text-brand-muted">{point.copy}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>
	</main>
</Layout>
