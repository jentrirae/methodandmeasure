---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Terms of Use — Method &amp; Measure" description="Terms of use and digital product terms for Method &amp; Measure.">
	<main class="bg-brand-cream">
		<section class="mx-auto max-w-3xl px-6 py-16 lg:px-8 lg:py-24">
			<p class="text-brand-muted font-sans text-xs tracking-editorial uppercase">LEGAL</p>
			<h1 class="mt-3 font-serif text-4xl md:text-5xl text-brand-black leading-tight">Terms of Use &amp; Digital Product Terms</h1>
			<p class="mt-4 font-sans text-xs tracking-editorial uppercase text-brand-muted">Last Updated: August 9, 2026</p>

			<div class="mt-12 flex flex-col gap-10 font-sans text-sm leading-relaxed text-brand-muted">
				<p>
					These Terms of Use ("Terms") govern your access to and use of the Method &amp; Measure website,
					services, and digital products. By using this site, submitting an inquiry, or purchasing a
					digital product, you agree to these Terms. If you do not agree, please do not use this site.
				</p>

				<div>
					<h2 class="font-serif text-2xl text-brand-black">Use of This Site</h2>
