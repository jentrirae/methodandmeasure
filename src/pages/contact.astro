---
import Layout from "../layouts/Layout.astro";

const steps = [
	{ index: "01", label: "Business Context" },
	{ index: "02", label: "Operational Needs" },
	{ index: "03", label: "Scope & Timeline" },
	{ index: "04", label: "Review & Submit" },
];

const focusAreas = [
	"Operations & Systems",
	"Administrative Support",
	"Projects & Implementation",
	"Documentation & Organization",
];

const inputClasses =
	"w-full border border-brand-border bg-brand-card px-4 py-3 font-sans text-sm text-brand-black placeholder:text-brand-muted focus:border-brand-black focus:outline-none";
const labelClasses = "font-sans text-xs tracking-editorial uppercase text-brand-black";
---

<Layout title="Contact — Method &amp; Measure" description="Tell us about your business so we can scope the right engagement.">
	<main class="bg-brand-cream">
		<!-- PAGE HERO -->
		<section class="mx-auto max-w-4xl px-6 py-16 lg:px-8 lg:py-20">
			<p class="text-brand-muted font-sans text-xs tracking-editorial uppercase">CONTACT</p>
			<h1 class="mt-3 font-serif text-5xl md:text-6xl text-brand-black leading-tight">Let's find the right fit.</h1>
			<p class="mt-6 max-w-xl font-sans text-sm leading-relaxed text-brand-muted">
				A few quick questions about your business and where things stand today. It takes about three
				minutes, and there's no commitment — just the information needed to scope a fit.
			</p>
		</section>

		<!-- STEP INDICATOR -->
		<section class="border-y border-brand-border">
			<div class="mx-auto max-w-4xl px-6 py-6 lg:px-8">
				<ol id="step-indicator" class="flex flex-wrap items-center gap-x-8 gap-y-3">
					{
						steps.map((step, i) => (
							<li
								data-step-indicator={i + 1}
								class:list={[
									"step-indicator-item flex items-center gap-2 border-b pb-1 transition-colors",
									i === 0 ? "border-brand-black" : "border-transparent",
								]}
							>
								<span
									class:list={[
										"step-indicator-index font-serif text-sm italic",
										i === 0 ? "text-brand-black" : "text-brand-muted",
									]}
								>
									{step.index}
								</span>
								<span
									class:list={[
										"step-indicator-label font-sans text-xs tracking-editorial uppercase",
										i === 0 ? "text-brand-black" : "text-brand-muted",
									]}
								>
									{step.label}
								</span>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<!-- FORM -->
		<section class="mx-auto max-w-4xl px-6 py-16 lg:px-8">
			<form id="inquiry-form" novalidate>
				<div id="form-fields">
				<!-- STEP 1: BUSINESS CONTEXT -->
				<fieldset data-step="1" class="flex flex-col gap-6">
					<legend class="font-serif text-2xl text-brand-black mb-2">Business Context</legend>

					<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
						<div class="flex flex-col gap-2">
							<label class={labelClasses} for="business-name">Business Name</label>
							<input id="business-name" name="businessName" type="text" required class={inputClasses} placeholder="e.g. The Corner Bistro" />
						</div>
						<div class="flex flex-col gap-2">
							<label class={labelClasses} for="contact-name">Your Name</label>
							<input id="contact-name" name="contactName" type="text" required class={inputClasses} placeholder="Jane Doe" />
						</div>
					</div>

					<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
						<div class="flex flex-col gap-2">
							<label class={labelClasses} for="email">Email</label>
							<input id="email" name="email" type="email" required class={inputClasses} placeholder="jane@example.com" />
						</div>
						<div class="flex flex-col gap-2">
							<label class={labelClasses} for="industry">Industry</label>
							<select id="industry" name="industry" required class={inputClasses}>
								<option value="">Select one</option>
								<option>Restaurant / Hospitality</option>
								<option>Retail</option>
								<option>Professional Services</option>
								<option>Other</option>
							</select>
						</div>
					</div>

					<div class="flex flex-col gap-2 sm:w-1/2 sm:pr-3">
						<label class={labelClasses} for="team-size">Team Size</label>
						<select id="team-size" name="teamSize" required class={inputClasses}>
							<option value="">Select one</option>
							<option>Just me</option>
							<option>2–10</option>
							<option>11–50</option>
							<option>50+</option>
						</select>
					</div>
				</fieldset>

				<!-- STEP 2: OPERATIONAL NEEDS -->
				<fieldset data-step="2" class="hidden flex-col gap-6">
					<legend class="font-serif text-2xl text-brand-black mb-2">Operational Needs</legend>

					<div class="flex flex-col gap-3">
						<span class={labelClasses}>Where do you need support? (Select all that apply)</span>
						<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
							{
								focusAreas.map((area) => (
									<label class="flex items-center gap-3 border border-brand-border bg-brand-card px-4 py-3 font-sans text-sm text-brand-black">
										<input type="checkbox" name="focusAreas" value={area} class="h-4 w-4 accent-brand-black" />
										{area}
									</label>
								))
							}
						</div>
					</div>

					<div class="flex flex-col gap-2">
						<label class={labelClasses} for="bottleneck">What's the biggest bottleneck right now?</label>
						<textarea
							id="bottleneck"
							name="bottleneck"
							required
							rows="4"
							class={inputClasses}
							placeholder="Tell us what's not working today..."
						></textarea>
					</div>
				</fieldset>

				<!-- STEP 3: SCOPE & TIMELINE -->
				<fieldset data-step="3" class="hidden flex-col gap-6">
					<legend class="font-serif text-2xl text-brand-black mb-2">Scope &amp; Timeline</legend>

					<div class="flex flex-col gap-3">
						<span class={labelClasses}>Engagement Type</span>
						<div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
							{
								["One-time project", "Ongoing support", "Not sure yet"].map((option, i) => (
									<label class="flex items-center gap-3 border border-brand-border bg-brand-card px-4 py-3 font-sans text-sm text-brand-black">
										<input type="radio" name="engagementType" value={option} required checked={i === 0} class="h-4 w-4 accent-brand-black" />
										{option}
									</label>
								))
							}
						</div>
					</div>

					<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
						<div class="flex flex-col gap-2">
							<label class={labelClasses} for="budget">Budget Range</label>
							<select id="budget" name="budget" required class={inputClasses}>
								<option value="">Select one</option>
								<option>Under $1,000</option>
								<option>$1,000–$5,000</option>
								<option>$5,000–$15,000</option>
								<option>$15,000+</option>
							</select>
						</div>
						<div class="flex flex-col gap-2">
							<label class={labelClasses} for="start-date">Desired Start</label>
							<select id="start-date" name="startDate" required class={inputClasses}>
								<option value="">Select one</option>
								<option>ASAP</option>
								<option>Within 1 month</option>
								<option>1–3 months</option>
								<option>Just exploring</option>
							</select>
						</div>
					</div>
				</fieldset>

				<!-- STEP 4: REVIEW & SUBMIT -->
				<fieldset data-step="4" class="hidden flex-col gap-6">
					<legend class="font-serif text-2xl text-brand-black mb-2">Review &amp; Submit</legend>
					<p class="font-sans text-sm leading-relaxed text-brand-muted">
						Double-check the details below. You can go back to any step to make changes before submitting.
					</p>
					<dl id="review-summary" class="flex flex-col divide-y divide-brand-border border-t border-b border-brand-border"></dl>
				</fieldset>

				<!-- FORM NAV -->
				<div class="mt-10 flex items-center justify-between border-t border-brand-border pt-8">
					<button
						type="button"
						id="prev-btn"
						class="font-sans text-xs uppercase tracking-editorial border-b border-brand-black pb-0.5 text-brand-black disabled:opacity-0"
						disabled
					>
						← BACK
					</button>

					<button
						type="button"
						id="next-btn"
						class="bg-brand-black text-brand-cream text-xs uppercase tracking-editorial px-6 py-3 transition-colors hover:bg-gray-800"
					>
						CONTINUE
					</button>

					<button
						type="submit"
						id="submit-btn"
						class="hidden bg-brand-black text-brand-cream text-xs uppercase tracking-editorial px-6 py-3 transition-colors hover:bg-gray-800"
					>
						SUBMIT INQUIRY
					</button>
				</div>
				</div>

				<p id="form-success" class="hidden mt-8 border border-brand-border bg-brand-card px-6 py-5 font-sans text-sm text-brand-black">
					Thanks — your inquiry has been received. We'll follow up by email within one to two business days.
				</p>
			</form>
		</section>
	</main>

	<script>
		const form = document.getElementById("inquiry-form") as HTMLFormElement;
		const fieldsets = Array.from(form.querySelectorAll<HTMLFieldSetElement>("fieldset[data-step]"));
		const stepIndicators = Array.from(document.querySelectorAll<HTMLLIElement>("[data-step-indicator]"));
		const prevBtn = document.getElementById("prev-btn") as HTMLButtonElement;
		const nextBtn = document.getElementById("next-btn") as HTMLButtonElement;
		const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
		const reviewSummary = document.getElementById("review-summary") as HTMLDListElement;
		const formSuccess = document.getElementById("form-success") as HTMLParagraphElement;

		const totalSteps = fieldsets.length;
		let currentStep = 1;

		const fieldLabels: Record<string, string> = {
			businessName: "Business Name",
			contactName: "Your Name",
			email: "Email",
			industry: "Industry",
			teamSize: "Team Size",
			focusAreas: "Focus Areas",
			bottleneck: "Biggest Bottleneck",
			engagementType: "Engagement Type",
			budget: "Budget Range",
			startDate: "Desired Start",
		};

		function showStep(step: number) {
			fieldsets.forEach((fieldset) => {
				const isActive = Number(fieldset.dataset.step) === step;
				fieldset.classList.toggle("hidden", !isActive);
				fieldset.classList.toggle("flex", isActive);
			});

			stepIndicators.forEach((item) => {
				const isActive = Number(item.dataset.stepIndicator) === step;
				const isComplete = Number(item.dataset.stepIndicator) < step;
				item.classList.toggle("border-brand-black", isActive);
				item.classList.toggle("border-transparent", !isActive);

				const indexEl = item.querySelector(".step-indicator-index");
				const labelEl = item.querySelector(".step-indicator-label");
				const activeColor = isActive || isComplete;
				indexEl?.classList.toggle("text-brand-black", activeColor);
				indexEl?.classList.toggle("text-brand-muted", !activeColor);
				labelEl?.classList.toggle("text-brand-black", activeColor);
				labelEl?.classList.toggle("text-brand-muted", !activeColor);
			});

			prevBtn.disabled = step === 1;
			nextBtn.classList.toggle("hidden", step === totalSteps);
			submitBtn.classList.toggle("hidden", step !== totalSteps);

			if (step === totalSteps) buildReview();
		}

		function currentFieldset(): HTMLFieldSetElement {
			return fieldsets[currentStep - 1];
		}

		function validateStep(): boolean {
			const fieldset = currentFieldset();
			const invalid = fieldset.querySelector<HTMLInputElement>(":invalid");
			if (invalid) {
				invalid.reportValidity();
				return false;
			}
			return true;
		}

		function buildReview() {
			const data = new FormData(form);
			const grouped = new Map<string, string[]>();

			for (const [key, value] of data.entries()) {
				if (!fieldLabels[key]) continue;
				const stringValue = String(value).trim();
				if (!stringValue) continue;
				const existing = grouped.get(key) ?? [];
				existing.push(stringValue);
				grouped.set(key, existing);
			}

			reviewSummary.innerHTML = "";
			for (const [key, label] of Object.entries(fieldLabels)) {
				const values = grouped.get(key);
				if (!values || values.length === 0) continue;

				const row = document.createElement("div");
				row.className = "flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6";

				const dt = document.createElement("dt");
				dt.className = "font-sans text-xs tracking-editorial uppercase text-brand-muted";
				dt.textContent = label;

				const dd = document.createElement("dd");
				dd.className = "font-sans text-sm text-brand-black sm:text-right";
				dd.textContent = values.join(", ");

				row.append(dt, dd);
				reviewSummary.appendChild(row);
			}
		}

		nextBtn.addEventListener("click", () => {
			if (!validateStep()) return;
			currentStep = Math.min(currentStep + 1, totalSteps);
			showStep(currentStep);
		});

		prevBtn.addEventListener("click", () => {
			currentStep = Math.max(currentStep - 1, 1);
			showStep(currentStep);
		});

		const formFields = document.getElementById("form-fields") as HTMLDivElement;

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (!validateStep()) return;
			formFields.classList.add("hidden");
			formSuccess.classList.remove("hidden");
		});

		showStep(currentStep);
	</script>
</Layout>
