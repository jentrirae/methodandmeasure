---
import { navLinks } from "../lib/nav";
---

<header class="border-b border-brand-border">
	<div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-8">
		<a href="/#top" class="font-serif text-xl tracking-tight text-brand-black">METHOD &amp; MEASURE</a>

		<nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
			{
				navLinks.map((item) => (
					<a
						href={item.href}
						class="font-sans text-xs tracking-editorial uppercase text-brand-black/80 transition-colors hover:text-brand-black"
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<button
			type="button"
			id="nav-toggle"
			class="-mr-2 p-2 text-brand-black md:hidden"
			aria-expanded="false"
			aria-controls="mobile-nav"
			aria-label="Toggle navigation menu"
		>
			<svg id="nav-icon-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-5 w-5">
				<path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
			</svg>
			<svg id="nav-icon-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="hidden h-5 w-5">
				<path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
			</svg>
		</button>
	</div>

	<nav id="mobile-nav" class="hidden border-t border-brand-border px-6 py-2 md:hidden" aria-label="Primary mobile">
		{
			navLinks.map((item) => (
				<a
					href={item.href}
					class="mobile-nav-link block py-3 font-sans text-xs tracking-editorial uppercase text-brand-black border-b border-brand-border last:border-b-0"
				>
					{item.label}
				</a>
			))
		}
	</nav>
</header>

<script>
	const toggle = document.getElementById("nav-toggle") as HTMLButtonElement;
	const menu = document.getElementById("mobile-nav") as HTMLElement;
	const iconOpen = document.getElementById("nav-icon-open") as SVGElement;
	const iconClose = document.getElementById("nav-icon-close") as SVGElement;

	function setOpen(isOpen: boolean) {
		menu.classList.toggle("hidden", !isOpen);
		iconOpen.classList.toggle("hidden", isOpen);
		iconClose.classList.toggle("hidden", !isOpen);
		toggle.setAttribute("aria-expanded", String(isOpen));
	}

	toggle.addEventListener("click", () => {
		setOpen(menu.classList.contains("hidden"));
	});

	menu.querySelectorAll<HTMLAnchorElement>(".mobile-nav-link").forEach((link) => {
		link.addEventListener("click", () => setOpen(false));
	});
</script>
