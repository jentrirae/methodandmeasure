---
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Systems that simplify. Strategy that scales." } = Astro.props;

const nav = [
	{ label: "SERVICES", href: "/services" },
	{ label: "TEMPLATES", href: "/shop" },
	{ label: "ABOUT", href: "/about" },
	{ label: "RESOURCES", href: "#" },
	{ label: "CONTACT", href: "/contact" },
];

const path = Astro.url.pathname;
const isActive = (href: string) => href !== "#" && (path === href || path.startsWith(`${href}/`));
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body class="bg-brand-cream font-sans antialiased">
		<!-- HEADER & NAVIGATION -->
		<header class="border-b border-brand-border">
			<div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-8">
				<a href="/" class="font-serif text-xl tracking-tight text-brand-black">
					M&amp;M <span class="hidden sm:inline">METHOD &amp; MEASURE</span>
				</a>

				<nav class="hidden items-center gap-8 md:flex">
					{
						nav.map((item) => (
							<a
								href={item.href}
								aria-current={isActive(item.href) ? "page" : undefined}
								class:list={[
									"font-sans text-xs tracking-editorial uppercase transition-colors hover:text-brand-muted",
									isActive(item.href) ? "text-brand-black" : "text-brand-black/80",
									isActive(item.href) && "border-b border-brand-black pb-0.5",
								]}
							>
								{item.label}
							</a>
						))
					}
				</nav>

				<a
					href="/contact"
					class="bg-brand-black text-brand-cream text-xs uppercase tracking-editorial px-5 py-2.5 transition-colors hover:bg-gray-800"
				>
					WORK WITH ME
				</a>
			</div>
		</header>

		<slot />

		<!-- FOOTER -->
		<footer class="bg-brand-black text-brand-cream py-16">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="flex flex-col justify-between gap-12 md:flex-row md:items-start">
					<div>
						<p class="font-serif text-2xl">M&amp;M</p>
						<p class="mt-3 font-sans text-xs tracking-editorial uppercase text-brand-cream/70">
							Systems that simplify. Strategy that scales.
						</p>
					</div>

					<div class="w-full max-w-sm">
						<p class="font-sans text-xs tracking-editorial uppercase text-brand-cream">STAY INSPIRED</p>
						<form class="mt-4 flex">
							<input
								type="email"
								placeholder="Your email address"
								class="w-full border border-white/20 bg-transparent px-4 py-3 font-sans text-sm text-brand-cream placeholder:text-brand-cream/50 focus:border-brand-cream focus:outline-none"
							/>
							<button
								type="submit"
								class="bg-brand-cream text-brand-black text-xs uppercase tracking-editorial px-5 py-3 whitespace-nowrap transition-colors hover:bg-white"
							>
								SUBSCRIBE
							</button>
						</form>
					</div>
				</div>

				<div
					class="mt-16 flex flex-col gap-4 border-t border-white/15 pt-8 text-xs text-brand-cream/60 md:flex-row md:items-center md:justify-between"
				>
					<p class="font-sans">&copy; {new Date().getFullYear()} Method &amp; Measure. All rights reserved.</p>
					<div class="flex items-center gap-6">
						<a href="#" class="font-sans tracking-editorial uppercase transition-colors hover:text-brand-cream">
							Privacy Policy
						</a>
						<a href="#" class="font-sans tracking-editorial uppercase transition-colors hover:text-brand-cream">
							Terms &amp; Conditions
						</a>
						<a href="#" aria-label="Instagram" class="transition-colors hover:text-brand-cream">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
								<rect x="3" y="3" width="18" height="18" rx="4" />
								<circle cx="12" cy="12" r="4" />
								<circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" />
							</svg>
						</a>
						<a href="#" aria-label="Pinterest" class="transition-colors hover:text-brand-cream">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
								<path d="M8 21c1-3 1.5-5.5 2-8" />
								<path d="M9.5 14.5c-1-2 0-6 3.5-6 3 0 4 2 4 4 0 3-1.5 5.5-4 5.5-1 0-1.8-.5-2-1.2" />
								<circle cx="12" cy="12" r="9" />
							</svg>
						</a>
					</div>
				</div>
			</div>
		</footer>
	</body>
</html>
