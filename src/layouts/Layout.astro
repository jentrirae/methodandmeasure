---
import "../styles/global.css";
import Header from "../components/Header.astro";
import { navLinks } from "../lib/nav";

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Systems that simplify. Strategy that scales." } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body class="bg-brand-cream font-sans antialiased">
		<Header />

		<slot />

		<!-- FOOTER -->
		<footer class="bg-brand-black text-brand-cream py-16">
			<div class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="flex flex-col gap-10 md:flex-row md:flex-wrap md:items-start md:justify-between lg:flex-nowrap">
					<div class="flex flex-col items-center gap-4">
						<img
							src="/logo-stacked.svg"
							alt="Method &amp; Measure"
							class="h-14 w-auto invert sm:h-16"
							loading="lazy"
						/>
						<a
							href="mailto:hello@methodandmeasure.com"
							class="font-sans text-sm text-brand-cream/70 transition-colors hover:text-brand-cream"
						>
							hello@methodandmeasure.com
						</a>
					</div>

					<div class="w-full max-w-xs">
						<p class="font-sans text-xs tracking-editorial uppercase text-brand-cream">THE OPERATIONS NOTE</p>
						<p class="mt-2 font-sans text-sm text-brand-cream/70">
							Practical systems, tools, and ideas for running a better business.
						</p>
						<form class="mt-4 flex">
							<input
								type="email"
								required
								placeholder="Your email address"
								class="w-full border border-white/20 bg-transparent px-3 py-2.5 font-sans text-sm text-brand-cream placeholder:text-brand-cream/50 focus:border-brand-cream focus:outline-none"
							/>
							<button
								type="submit"
								class="bg-brand-cream text-brand-black text-xs uppercase tracking-editorial px-4 py-2.5 whitespace-nowrap transition-colors hover:bg-white"
							>
								Subscribe
							</button>
						</form>
					</div>

					<div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:gap-16">
						<nav class="flex flex-col gap-3" aria-label="Footer">
							{
								navLinks.map((item) => (
									<a
										href={item.href}
										class="font-sans text-xs tracking-editorial uppercase text-brand-cream/70 transition-colors hover:text-brand-cream"
									>
										{item.label}
									</a>
								))
							}
						</nav>

						<div class="flex items-center gap-1">
							<a
								href="https://www.instagram.com/methodandmeasureco/"
								target="_blank"
								rel="noopener noreferrer"
								aria-label="Method & Measure on Instagram"
								class="p-3 text-brand-cream/70 transition-colors hover:text-brand-cream"
							>
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-5 w-5">
									<rect x="3" y="3" width="18" height="18" rx="4" />
									<circle cx="12" cy="12" r="4" />
									<circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" />
								</svg>
							</a>
							<a
								href="https://www.pinterest.com/methodandmeasure/"
								target="_blank"
								rel="noopener noreferrer"
								aria-label="Method & Measure on Pinterest"
								class="p-3 text-brand-cream/70 transition-colors hover:text-brand-cream"
							>
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-5 w-5">
									<path d="M8 21c1-3 1.5-5.5 2-8" />
									<path d="M9.5 14.5c-1-2 0-6 3.5-6 3 0 4 2 4 4 0 3-1.5 5.5-4 5.5-1 0-1.8-.5-2-1.2" />
									<circle cx="12" cy="12" r="9" />
								</svg>
							</a>
						</div>
					</div>
				</div>

				<div
					class="mt-12 flex flex-col gap-4 border-t border-white/15 pt-8 text-xs text-brand-cream/60 md:flex-row md:items-center md:justify-between"
				>
					<p class="font-sans">&copy; 2026 Method &amp; Measure</p>
					<div class="flex items-center gap-2">
						<a href="/privacy" class="font-sans tracking-editorial uppercase transition-colors hover:text-brand-cream px-2">
							Privacy
						</a>
						<a href="/terms" class="font-sans tracking-editorial uppercase transition-colors hover:text-brand-cream px-2">
							Terms
						</a>
					</div>
				</div>
			</div>
		</footer>
	</body>
</html>
